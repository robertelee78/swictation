#!/usr/bin/env node

const { spawn, execSync } = require('child_process');
const path = require('path');
const fs = require('fs');
const os = require('os');
const chalk = require('chalk');
const inquirer = require('inquirer');
const which = require('which');
const { configureNvidiaHibernation, checkNvidiaHibernationStatus } = require('../src/nvidia-hibernation-setup');
const { getIpcSocketPath, getMetricsSocketPath } = require('../src/socket-paths');
const { resolveBinaryPaths } = require('../src/resolve-binary');

// Platform detection
const isMacOS = process.platform === 'darwin';
const isLinux = process.platform === 'linux';

// Get binary paths from platform packages
let binaryPaths;
try {
  binaryPaths = resolveBinaryPaths();
} catch (err) {
  // If we can't resolve binary paths yet, some commands (like --version, help) can still work
  // We'll check this later for commands that need binaries
  binaryPaths = null;
}

// Binary locations from platform packages
const daemonBinary = binaryPaths ? binaryPaths.daemon : null;
const uiBinary = binaryPaths ? binaryPaths.ui : null;
const libDir = binaryPaths ? binaryPaths.libDir : null;

// Config directories (shared platform rules — ADR-034)
const configDir = require('../src/paths').getConfigDir();
const launchAgentsDir = path.join(os.homedir(), 'Library', 'LaunchAgents');

// Parse command line arguments
const args = process.argv.slice(2);
const command = args[0];

// Helper functions
function checkPlatform() {
  if (isLinux) {
    // Linux: x64 only
    if (process.arch !== 'x64') {
      console.error(chalk.red('Error: Swictation on Linux currently only supports x64 architecture'));
      process.exit(1);
    }
  } else if (isMacOS) {
    // macOS: ARM64 (Apple Silicon) only
    if (process.arch !== 'arm64') {
      console.error(chalk.red('Error: Swictation on macOS requires Apple Silicon (M1 or later)'));
      console.log(chalk.yellow('Intel Macs are not supported'));
      process.exit(1);
    }
  } else {
    console.error(chalk.red('Error: Swictation currently only supports Linux and macOS'));
    console.log(chalk.yellow(`Detected platform: ${process.platform}`));
    process.exit(1);
  }
}

function checkBinaries() {
  // If we couldn't resolve binary paths, show helpful error
  if (!binaryPaths) {
    console.error(chalk.red('Error: Platform package not found'));
    console.log(chalk.yellow('This usually means:'));
    console.log(chalk.yellow('  1. The platform package failed to install'));
    console.log(chalk.yellow(`  2. npm's optionalDependencies installation failed`));
    console.log(chalk.yellow('  3. You are on an unsupported platform'));
    console.log();
    console.log(chalk.cyan('Try reinstalling: npm install -g swictation --force'));
    process.exit(1);
  }

  if (!fs.existsSync(daemonBinary)) {
    console.error(chalk.red(`Error: Daemon binary not found at ${daemonBinary}`));
    console.log(chalk.yellow('The platform package is installed but binaries are missing'));
    console.log(chalk.yellow('Try reinstalling: npm install -g swictation --force'));
    process.exit(1);
  }

  if (!fs.existsSync(uiBinary)) {
    console.error(chalk.red(`Error: UI binary not found at ${uiBinary}`));
    console.log(chalk.yellow('The platform package is installed but binaries are missing'));
    console.log(chalk.yellow('Try reinstalling: npm install -g swictation --force'));
    process.exit(1);
  }

  // Make sure binaries are executable
  try {
    fs.chmodSync(daemonBinary, '755');
    fs.chmodSync(uiBinary, '755');
  } catch (err) {
    // Ignore EPERM errors for global installs (binaries already executable)
    if (err.code !== 'EPERM') {
      console.error(chalk.red('Error: Could not set binary permissions'), err);
      process.exit(1);
    }
  }
}

function isRunning(serviceName) {
  try {
    if (isLinux) {
      const output = execSync(`systemctl --user is-active ${serviceName}`, { encoding: 'utf8' }).trim();
      return output === 'active';
    } else if (isMacOS) {
      // Convert service name to launchd label (e.g., swictation-daemon -> com.swictation.daemon)
      const label = serviceName === 'swictation-daemon' ? 'com.swictation.daemon' : 'com.swictation.ui';
      const output = execSync(`launchctl list | grep ${label}`, { encoding: 'utf8' }).trim();
      return output.length > 0;
    }
    return false;
  } catch {
    return false;
  }
}

function detectDisplayServer() {
  const waylandDisplay = process.env.WAYLAND_DISPLAY;
  const x11Display = process.env.DISPLAY;
  const sessionType = process.env.XDG_SESSION_TYPE;

  if (waylandDisplay || sessionType === 'wayland') {
    return 'wayland';
  } else if (x11Display) {
    return 'x11';
  }
  return 'unknown';
}

function detectWindowManager() {
  // Check for Sway
  if (process.env.SWAYSOCK) {
    return 'sway';
  }

  // Check for i3
  try {
    which.sync('i3');
    const i3Check = execSync('i3 --version 2>/dev/null', { encoding: 'utf8' });
    if (i3Check.includes('i3')) {
      return 'i3';
    }
  } catch {}

  // Check XDG_CURRENT_DESKTOP
  const desktop = process.env.XDG_CURRENT_DESKTOP;
  if (desktop) {
    return desktop.toLowerCase();
  }

  return 'unknown';
}

// Command handlers
async function handleStart() {
  console.log(chalk.cyan('Starting Swictation services...'));

  // Check if already running
  if (isRunning('swictation-daemon')) {
    console.log(chalk.yellow('Daemon is already running'));
  } else {
    try {
      if (isLinux) {
        execSync('systemctl --user start swictation-daemon');
        console.log(chalk.green('✓ Daemon started'));
      } else if (isMacOS) {
        const plistPath = path.join(launchAgentsDir, 'com.swictation.daemon.plist');
        if (!fs.existsSync(plistPath)) {
          console.error(chalk.red('LaunchAgent not found. Run: swictation setup'));
          process.exit(1);
        }
        execSync(`launchctl bootstrap gui/$(id -u) "${plistPath}" 2>/dev/null || launchctl load "${plistPath}"`);
        execSync('launchctl start com.swictation.daemon');
        console.log(chalk.green('✓ Daemon started'));
      }
    } catch (err) {
      console.error(chalk.red('Failed to start daemon:'), err.message);
      console.log(chalk.yellow('Try running manually:'), daemonBinary);
    }
  }

  // Start UI if requested
  if (args.includes('--ui')) {
    try {
      if (isMacOS) {
        const uiPlistPath = path.join(launchAgentsDir, 'com.swictation.ui.plist');
        if (fs.existsSync(uiPlistPath)) {
          execSync(`launchctl bootstrap gui/$(id -u) "${uiPlistPath}" 2>/dev/null || launchctl load "${uiPlistPath}"`);
          execSync('launchctl start com.swictation.ui');
        } else {
          // Fall back to direct spawn if plist doesn't exist
          spawn(uiBinary, [], {
            detached: true,
            stdio: 'ignore',
            env: getEnvironmentWithLibraryPath()
          }).unref();
        }
      } else {
        spawn(uiBinary, [], {
          detached: true,
          stdio: 'ignore',
          env: getEnvironmentWithLibraryPath()
        }).unref();
      }
      console.log(chalk.green('✓ UI launched'));
    } catch (err) {
      console.error(chalk.red('Failed to launch UI:'), err.message);
    }
  }
}

async function handleStop() {
  console.log(chalk.cyan('Stopping Swictation services...'));

  try {
    if (isLinux) {
      execSync('systemctl --user stop swictation-daemon');
      console.log(chalk.green('✓ Daemon stopped'));
    } else if (isMacOS) {
      // Stop UI first (depends on daemon)
      try {
        execSync('launchctl stop com.swictation.ui');
        const uiPlistPath = path.join(launchAgentsDir, 'com.swictation.ui.plist');
        if (fs.existsSync(uiPlistPath)) {
          execSync(`launchctl bootout gui/$(id -u) com.swictation.ui 2>/dev/null || launchctl unload "${uiPlistPath}"`);
        }
      } catch (err) {
        // UI might not be running
      }

      // Then stop daemon
      execSync('launchctl stop com.swictation.daemon');
      const daemonPlistPath = path.join(launchAgentsDir, 'com.swictation.daemon.plist');
      if (fs.existsSync(daemonPlistPath)) {
        execSync(`launchctl bootout gui/$(id -u) com.swictation.daemon 2>/dev/null || launchctl unload "${daemonPlistPath}"`);
      }
      console.log(chalk.green('✓ Daemon stopped'));
    }
  } catch (err) {
    console.error(chalk.red('Failed to stop daemon:'), err.message);
  }
}

async function handleStatus() {
  console.log(chalk.cyan('Swictation Service Status:'));
  console.log(chalk.gray('─'.repeat(40)));

  // Check daemon status
  const daemonActive = isRunning('swictation-daemon');
  console.log(`Daemon: ${daemonActive ? chalk.green('● Active') : chalk.gray('○ Inactive')}`);

  // Check socket (use new secure path)
  const ipcSocket = getIpcSocketPath();
  const socketExists = fs.existsSync(ipcSocket);
  console.log(`Socket: ${socketExists ? chalk.green('● Connected') : chalk.gray('○ Not found')}`);
  console.log(`  Path: ${chalk.gray(ipcSocket)}`);

  // Check metrics socket (use new secure path)
  const metricsSocket = getMetricsSocketPath();
  const metricsExists = fs.existsSync(metricsSocket);
  console.log(`Metrics: ${metricsExists ? chalk.green('● Connected') : chalk.gray('○ Not found')}`);
  console.log(`  Path: ${chalk.gray(metricsSocket)}`);

  // Display system info
  console.log(chalk.gray('─'.repeat(40)));
  console.log(`Platform: ${chalk.blue(isMacOS ? 'macOS (CoreML/Metal)' : 'Linux (CUDA)')}`);

  if (isLinux) {
    const displayServer = detectDisplayServer();
    const windowManager = detectWindowManager();
    console.log(`Display: ${chalk.blue(displayServer)}`);
    console.log(`Window Manager: ${chalk.blue(windowManager)}`);
  } else if (isMacOS) {
    console.log(`Display: ${chalk.blue('Quartz (macOS native)')}`);
    console.log(`Architecture: ${chalk.blue(process.arch)}`);
  }
}

/** (color, message) logger the step registry expects, rendered with chalk. */
const chalkLog = (color, message) => console.log((chalk[color] || chalk.white)(message));

/**
 * Build the step context `setup` and `doctor` share (ADR-037).
 * `swictation` is the non-npm entry point, so the plan is filtered to steps
 * that list `setup` — postinstall-only work never runs from the CLI.
 */
function buildStepContext(mode, extraFacts = {}) {
  const steps = require('../src/steps');
  return {
    steps,
    ctx: steps.createContext({
      mode,
      log: chalkLog,
      ...extraFacts,
    }),
  };
}

/**
 * The model this machine should have, resolved BEFORE the context is built.
 *
 * On an `npm install --ignore-scripts` there is no gpu-info.json, so nothing
 * has ever decided — and `swictation setup` is the only recovery path those
 * installs get. Detection lives here rather than inside the models step
 * because it logs and writes gpu-info.json: a step's check() must stay
 * side-effect-free, and doctor must never trigger it at all.
 */
function resolveSelectedModelForSetup() {
  const steps = require('../src/steps');
  const saved = steps.readSavedGpuInfo();
  if (saved && typeof saved.recommendedModel === 'string') return {};

  console.log(chalk.cyan('No hardware profile recorded yet — detecting...'));
  try {
    const postinstall = require('../postinstall.js');
    const gpuInfo = isMacOS
      ? postinstall.detectUnifiedMemoryMacOS()
      : postinstall.detectGPUVRAM();
    return { gpuInfo, selectedModel: gpuInfo && gpuInfo.recommendedModel };
  } catch (err) {
    console.log(chalk.yellow(`Could not detect hardware: ${err.message}`));
    return {};
  }
}

const STATE_RENDER = {
  healthy: { label: 'HEALTHY', color: 'green' },
  unhealthy: { label: 'UNHEALTHY', color: 'red' },
  blocked: { label: 'BLOCKED', color: 'yellow' },
  'not-applicable': { label: 'N/A', color: 'gray' },
  unknown: { label: 'UNKNOWN', color: 'yellow' },
};

const STATUS_RENDER = {
  ok: { label: 'ok', color: 'green' },
  already: { label: 'already', color: 'green' },
  failed: { label: 'FAILED', color: 'red' },
  blocked: { label: 'BLOCKED', color: 'yellow' },
  'not-applicable': { label: 'n/a', color: 'gray' },
};

function installLogPath() {
  return isMacOS
    ? path.join(os.homedir(), 'Library', 'Logs', 'swictation', 'install.log')
    : path.join(os.homedir(), '.local', 'share', 'swictation', 'install.log');
}

function packageVersion() {
  try {
    return require('../package.json').version;
  } catch {
    return 'unknown';
  }
}

/** The context header every doctor report opens with (amendment 9). */
function doctorContext(ctx) {
  return {
    version: packageVersion(),
    platform: `${ctx.platform} ${ctx.arch}`,
    effectiveUser: ctx.effectiveUser,
    targetUser: ctx.targetUser,
    targetHome: ctx.targetHome,
    elevated: ctx.elevatedForAnother,
    mode: ctx.mode,
    selectedModel: ctx.selectedModel,
    gpu: (ctx.gpuInfo && ctx.gpuInfo.gpuName) || null,
    logPath: installLogPath(),
  };
}

/**
 * `swictation doctor` — evaluate every step's check() and report.
 * Nothing is executed: check() is side-effect-free by contract, which is
 * what makes this safe on a machine that is mid-failure. Doctor IS the
 * read-only plan, so no mutating code carries a dryRun branch.
 */
async function handleDoctor() {
  const wantsJson = args.includes('--json');
  // --deep re-reads every byte of the models and GPU libraries and compares
  // sha256 against what was recorded when they were written. Opt-in because
  // it is minutes of I/O on a 7 GB model tree, not because it is risky:
  // it still runs no step and writes nothing.
  const wantsDeep = args.includes('--deep');
  let steps;
  let ctx;
  let rows;

  try {
    ({ steps, ctx } = buildStepContext('doctor'));
    if (wantsDeep && !wantsJson) {
      console.log(chalk.cyan('Deep verification: hashing model and GPU library files...'));
    }
    // Every step, not just the applicable ones: a table that silently omits
    // gpu-libs leaves the reader unsure whether it passed or was never
    // considered. checkAll() labels it not-applicable and says why.
    rows = await steps.checkAll(steps.STEPS, ctx, { deep: wantsDeep });
  } catch (err) {
    // Exit 2 is reserved for doctor itself being broken, so a genuine
    // unhealthy install is never confused with a crashed diagnostic.
    if (wantsJson) {
      console.log(JSON.stringify({ schemaVersion: 1, error: err.message }, null, 2));
    } else {
      console.error(chalk.red(`doctor failed: ${err.message}`));
    }
    process.exit(2);
  }

  const context = doctorContext(ctx);

  if (wantsJson) {
    console.log(JSON.stringify({
      schemaVersion: 1,
      tool: 'swictation doctor',
      generatedAt: new Date().toISOString(),
      // Part of the report, not a flag echo: a consumer comparing two runs
      // must be able to tell a size check from a content check.
      depth: wantsDeep ? 'deep' : 'standard',
      context,
      steps: rows.map(row => ({
        id: row.id,
        title: row.title,
        state: row.health.state,
        code: row.health.code,
        summary: row.health.summary,
        evidence: row.health.evidence,
        repair: row.health.repair || row.repair,
      })),
    }, null, 2));
    process.exit(steps.exitCodeForRows(rows));
  }

  const userLine = context.elevated
    ? `${context.effectiveUser} → ${context.targetUser} (${context.targetHome || 'home unknown'})`
    : `${context.effectiveUser} (${context.targetHome || 'home unknown'})`;

  console.log(chalk.cyan(`\nswictation v${context.version} — doctor${wantsDeep ? ' (deep)' : ''}`));
  console.log(chalk.gray(`  platform  ${context.platform}`));
  console.log(chalk.gray(`  user      ${userLine}`));
  console.log(chalk.gray(`  mode      ${context.mode}`));
  console.log(chalk.gray(`  model     ${context.selectedModel || 'not selected'}${context.gpu ? ` (${context.gpu})` : ''}`));
  console.log(chalk.gray(`  log       ${context.logPath}`));
  console.log(chalk.gray('─'.repeat(72)));

  for (const row of rows) {
    const render = STATE_RENDER[row.health.state] || STATE_RENDER.unknown;
    const paint = chalk[render.color] || chalk.white;
    console.log(
      paint(render.label.padEnd(10)) +
      chalk.white(row.id.padEnd(14)) +
      chalk.gray(`${row.health.code.padEnd(26)} ${row.health.summary}`)
    );
    // Evidence and the repair command only where something is wrong: on a
    // healthy machine the table stays one line per step.
    if (row.health.state !== 'healthy') {
      for (const item of row.health.evidence) console.log(chalk.gray(`    ${item}`));
      if (row.health.state !== 'not-applicable') {
        console.log(chalk.yellow(`    repair: ${row.health.repair || row.repair}`));
      }
    }
  }

  console.log(chalk.gray('─'.repeat(72)));
  const exitCode = steps.exitCodeForRows(rows);
  if (exitCode === 0) {
    const unknowns = rows.filter(r => r.health.state === 'unknown').length;
    console.log(unknowns > 0
      ? chalk.yellow(`No failures. ${unknowns} step(s) could not be fully verified.`)
      : chalk.green(wantsDeep ? 'All checks healthy (contents verified).' : 'All checks healthy.'));
    if (!wantsDeep) {
      console.log(chalk.gray('Sizes were checked, not contents — "swictation doctor --deep" hashes every file.'));
    }
  } else {
    console.log(chalk.yellow('Run "swictation setup --repair" to fix everything above.'));
  }
  process.exit(exitCode);
}

/**
 * Run the requested steps and print a ledger.
 * @param {object} options - { ids?: string[], repair?: boolean }
 * @returns {Promise<boolean>} true when nothing failed or was blocked
 */
async function runSetupSteps(options = {}) {
  const { ids, repair = false } = options;
  const { steps, ctx } = buildStepContext('setup', resolveSelectedModelForSetup());

  let plan = steps.selectSteps({ ids, entrypoint: 'setup' });

  // A step the user named that this entry point may not run is a FAILED
  // request, not an empty one. `setup --cleanup` deletes other installations'
  // files and is npm-lifecycle-only; without this it filtered to an empty
  // plan, printed nothing, and exited 0 as though it had done the work.
  if (Array.isArray(ids) && ids.length > 0) {
    const unavailable = ids.filter(id => !plan.some(step => step.id === id));
    if (unavailable.length > 0) {
      for (const id of unavailable) {
        const step = steps.getStep(id);
        console.error(chalk.red(`Cannot run "${id}" from swictation setup.`));
        console.error(chalk.gray(`  It runs only during: ${(step.entrypoints || []).join(', ')}`));
      }
      return false;
    }
  }

  if (repair) {
    plan = await steps.failingSteps(plan, ctx);
    if (plan.length === 0) {
      console.log(chalk.green('Nothing to repair — every check already passes.'));
      return true;
    }
    console.log(chalk.cyan(`Repairing: ${plan.map(s => s.id).join(', ')}`));
  }

  const results = await steps.runSteps(plan, ctx);

  console.log(chalk.gray(`\n${'─'.repeat(72)}`));
  for (const r of results) {
    const render = STATUS_RENDER[r.status] || { label: r.status, color: 'yellow' };
    const paint = chalk[render.color] || chalk.white;
    console.log(
      paint(render.label.padEnd(10)) +
      chalk.white(r.id.padEnd(14)) +
      chalk.gray(`${r.health.code.padEnd(26)} ${r.health.summary}`)
    );
    // This ledger is the compact one-line-per-step SUMMARY. The detailed
    // evidence + repair for non-healthy steps is already printed by
    // runStep()'s announce() as each step runs, so it must NOT be repeated
    // here — doing so re-created the double-print this round set out to fix.
    if (r.status === 'failed' || r.status === 'blocked') {
      console.log(chalk.yellow(`    repair: ${r.health.repair || steps.repairCommand(steps.getStep(r.id))}`));
    }
  }

  // A step the user NAMED that did not actually run is a failure of that
  // request, even when the reason is benign — `setup --gpu-libs` on a Mac
  // must not exit 0 as though it had installed something. In a full or
  // --repair run, not-applicable is just accurate reporting.
  const targeted = Array.isArray(ids) && ids.length > 0;
  return results.every(r => (targeted
    ? (r.status === 'ok' || r.status === 'already')
    : (r.status !== 'failed' && r.status !== 'blocked')));
}

function listSteps() {
  const { steps, ctx } = buildStepContext('setup');
  console.log(chalk.cyan('Install steps (run one with "swictation setup --<id>"):'));
  for (const step of steps.STEPS) {
    const gates = [];
    if (step.needsNetwork) gates.push('network');
    if (step.needsSession) gates.push('session');
    if (step.forbidRoot) gates.push('non-root');
    const gating = gates.length > 0 ? chalk.gray(`  needs: ${gates.join(', ')}`) : '';
    const after = (step.after || []).length > 0 ? chalk.gray(`  after: ${step.after.join(', ')}`) : '';
    const scope = steps.appliesTo(step, ctx) ? '' : chalk.gray('  (not applicable here)');
    // Steps this command cannot run are listed — doctor reports them, so
    // leaving them out would leave the reader unable to look one up — but
    // they are labelled rather than offered.
    const reach = (step.entrypoints || []).includes('setup')
      ? ''
      : chalk.yellow('  (install only — not runnable from setup)');
    console.log(`  ${chalk.white(step.id.padEnd(14))} ${step.title}${gating}${after}${scope}${reach}`);
  }
}

async function handleSetup() {
  const { steps: registry } = buildStepContext('setup');
  const stepIds = registry.STEPS.map(s => s.id);
  const knownFlags = new Set(['--list', '--repair', ...stepIds.map(id => `--${id}`)]);

  // Reject anything unrecognized rather than ignoring it: silently falling
  // through to a full setup would start multi-gigabyte downloads the user
  // never asked for, which is the opposite of a targeted repair. Bare words
  // are rejected on the same footing as dashed flags — `setup models` is a
  // typo for `setup --models`, and treating it as "no arguments" is exactly
  // the failure mode the dashed check was added to prevent.
  const unrecognized = args.slice(1).filter(arg => !knownFlags.has(arg));
  if (unrecognized.length > 0) {
    const dashed = unrecognized.filter(a => a.startsWith('-'));
    const bare = unrecognized.filter(a => !a.startsWith('-'));
    if (dashed.length > 0) {
      console.error(chalk.red(`Unknown setup option(s): ${dashed.join(', ')}`));
    }
    for (const word of bare) {
      const suggestion = stepIds.includes(word) ? ` — did you mean "--${word}"?` : '';
      console.error(chalk.red(`Unexpected argument: ${word}${suggestion}`));
    }
    console.log(chalk.yellow('Run "swictation setup --list" to see the available steps'));
    process.exit(1);
  }

  // Targeted invocations (--list / --<id> / --repair) are non-interactive:
  // a scripted repair must not stop to ask about auto-start.
  if (args.includes('--list')) {
    listSteps();
    return;
  }

  const requested = stepIds.filter(id => args.includes(`--${id}`));
  const repair = args.includes('--repair');

  if (requested.length > 0 || repair) {
    const ok = await runSetupSteps({ ids: requested.length > 0 ? requested : undefined, repair });
    if (!ok) process.exit(1);
    return;
  }

  console.log(chalk.cyan('Setting up Swictation...'));
  console.log(chalk.gray(isMacOS ? 'This will configure launchd services' : 'This will configure systemd services and hotkeys'));

  // Sampled BEFORE the services step regenerates the plists, because that
  // regeneration boots the agents out and the answer is gone afterwards.
  // A user who runs `swictation setup` to fix a hotkey and then declines
  // auto-start expects the daemon they had running to still be running —
  // not to discover hours later that a setup they ran for something else
  // silently stopped it. RunAtLoad is untouched: whether the agent starts at
  // login stays whatever the generated plist says.
  const launchdWasRunning = isMacOS
    ? require('../postinstall.js').launchdServiceState()
    : { daemon: false, ui: false };

  // Create config directory
  if (!fs.existsSync(configDir)) {
    fs.mkdirSync(configDir, { recursive: true });
    console.log(chalk.green('✓ Created config directory'));
  }

  if (isLinux) {
    // systemd is what the services step writes units for; without it there is
    // nothing for setup to configure.
    try {
      which.sync('systemctl');
    } catch {
      console.error(chalk.red('Error: systemd is required but not found'));
      process.exit(1);
    }
  }

  // The steps themselves (ADR-037): config, GPU libraries, models and service
  // units all go through the registry postinstall uses, so this recovery path
  // can no longer diverge from the install path — which is exactly how the
  // ADR-034 blank-output bug got in (an inline unit generator here that
  // omitted ORT_DYLIB_PATH).
  const stepsOk = await runSetupSteps();

  if (isLinux) {
    // Configure hotkeys based on window manager
    const wm = detectWindowManager();
    if (wm === 'sway') {
      console.log(chalk.cyan('\nDetected Sway window manager'));
      console.log(chalk.yellow('Add this to your ~/.config/sway/config:'));
      console.log(chalk.gray('─'.repeat(40)));
      console.log(chalk.white('bindsym Super+Shift+d exec swictation toggle'));
      console.log(chalk.gray('─'.repeat(40)));
    } else if (wm === 'i3') {
      console.log(chalk.cyan('\nDetected i3 window manager'));
      console.log(chalk.yellow('Add this to your ~/.config/i3/config:'));
      console.log(chalk.gray('─'.repeat(40)));
      console.log(chalk.white('bindsym Mod4+Shift+d exec swictation toggle'));
      console.log(chalk.gray('─'.repeat(40)));
    }

  } else if (isMacOS) {
    // The services step has just generated and loaded the LaunchAgents, so
    // this no longer dead-ends on "reinstall the package" when they are
    // missing — that recovery hole is what ADR-037 set out to close.

    // Accessibility permissions check
    console.log(chalk.cyan('\n🔐 Accessibility Permissions Required:'));
    console.log(chalk.yellow('   Swictation needs Accessibility permissions to inject text'));
    console.log(chalk.gray('   ─'.repeat(40)));
    console.log(chalk.white('   1. Open System Settings'));
    console.log(chalk.white('   2. Navigate to Privacy & Security → Accessibility'));
    console.log(chalk.white('   3. Add swictation-daemon to the allowed applications'));
    console.log(chalk.white('   4. Enable the checkbox'));
    console.log(chalk.gray('   ─'.repeat(40)));

    // Hotkey configuration (must match config.rs macOS default: Ctrl+Shift+D)
    console.log(chalk.cyan('\n⌨️  Default Hotkey: Ctrl+Shift+D'));
    console.log(chalk.gray('   (Hotkey is built-in to the daemon via global-hotkey crate)'));
  }

  // Ask if user wants to enable auto-start
  const { autostart } = await inquirer.prompt([
    {
      type: 'confirm',
      name: 'autostart',
      message: 'Enable Swictation to start automatically on login?',
      default: true
    }
  ]);

  if (autostart) {
    try {
      if (isLinux) {
        execSync('systemctl --user enable swictation-daemon');
        console.log(chalk.green('✓ Auto-start enabled'));
      } else if (isMacOS) {
        const daemonPlist = path.join(launchAgentsDir, 'com.swictation.daemon.plist');
        execSync(`launchctl bootstrap gui/$(id -u) "${daemonPlist}" 2>/dev/null || launchctl load "${daemonPlist}"`);
        console.log(chalk.green('✓ Auto-start enabled (plist loaded)'));
      }
    } catch (err) {
      console.error(chalk.yellow('Warning: Could not enable auto-start'), err.message);
    }
  } else if (isMacOS && (launchdWasRunning.daemon.running || launchdWasRunning.ui.running)) {
    // Declining auto-start answers "should this start at login?" — it is not
    // an instruction to stop what is already RUNNING. Regenerating the plists
    // stopped these; put them back the way this command found them. A service
    // that was loaded but stopped is deliberately not restored: the plists
    // carry RunAtLoad, so bootstrapping it would start something the user had
    // stopped, which is the opposite of leaving the machine as it was.
    const restored = require('../postinstall.js').restoreLaunchdServices(launchdWasRunning);
    if (restored.length > 0) {
      console.log(chalk.green(`✓ Restored the service(s) that were running: ${restored.join(', ')}`));
    } else {
      console.log(chalk.yellow('⚠ Could not restart the services that were running before setup'));
      console.log(chalk.cyan('  Start them with: swictation start'));
    }
  }

  // Platform-specific checks
  if (isLinux) {
    // Linux: Check NVIDIA hibernation (laptops only)
    console.log(chalk.cyan('\n📱 Checking NVIDIA hibernation support...'));
    const nvidiaStatus = checkNvidiaHibernationStatus();

    if (nvidiaStatus.needsConfiguration) {
      console.log(chalk.yellow('\n⚠️  NVIDIA hibernation support not configured'));
      console.log(chalk.gray('   This is required to prevent GPU errors after laptop hibernation'));

      const { configureNvidia } = await inquirer.prompt([
        {
          type: 'confirm',
          name: 'configureNvidia',
          message: 'Configure NVIDIA hibernation support now? (requires sudo)',
          default: true
        }
      ]);

      if (configureNvidia) {
        console.log(chalk.cyan('\n🔧 Configuring NVIDIA hibernation support...'));
        const result = await configureNvidiaHibernation({
          interactive: false,
          log: (msg) => console.log(chalk.cyan(msg))
        });

        if (result.success) {
          console.log(chalk.green('✓ NVIDIA hibernation configured'));
          if (result.needsReboot) {
            console.log(chalk.yellow('⚠️  Reboot required for changes to take effect'));
          }
        } else {
          console.log(chalk.red('✗ Configuration failed:'), result.message);
        }
      } else {
        console.log(chalk.yellow('⚠️  Skipping NVIDIA configuration'));
        console.log(chalk.cyan('   You can configure later by running: sudo swictation setup'));
      }
    } else if (nvidiaStatus.isLaptop && nvidiaStatus.hasNvidiaGpu && nvidiaStatus.isConfigured) {
      console.log(chalk.green('✓ NVIDIA hibernation support already configured'));
    } else if (!nvidiaStatus.isLaptop) {
      console.log(chalk.cyan('ℹ Not a laptop - NVIDIA hibernation check skipped'));
    } else if (!nvidiaStatus.hasNvidiaGpu) {
      console.log(chalk.cyan('ℹ No NVIDIA GPU detected'));
    }
  }

  if (stepsOk) {
    console.log(chalk.green('\n✓ Setup complete!'));
    console.log(chalk.cyan('Run "swictation start" to begin using Swictation'));
  } else {
    console.log(chalk.yellow('\n⚠ Setup finished with failed steps (listed above).'));
    console.log(chalk.cyan('Run "swictation doctor" for details, then "swictation setup --repair"'));
    process.exitCode = 1;
  }
}

async function handleToggle() {
  // Send toggle command to daemon using secure socket path
  try {
    const net = require('net');
    const socketPath = getIpcSocketPath();
    const client = net.createConnection(socketPath);

    client.on('connect', () => {
      client.write(JSON.stringify({ action: 'toggle' }));
    });

    client.on('data', (data) => {
      const response = JSON.parse(data.toString());
      if (response.status === 'success') {
        console.log(chalk.green('✓'), response.message);
      } else {
        console.error(chalk.red('✗'), response.error);
      }
      client.end();
    });

    client.on('error', (err) => {
      console.error(chalk.red('Error: Cannot connect to daemon'));
      console.log(chalk.yellow('Is the daemon running? Try: swictation start'));
    });
  } catch (err) {
    console.error(chalk.red('Error:'), err.message);
  }
}

async function handleDownloadModels() {
  const ModelDownloader = require(path.join(__dirname, '..', 'lib', 'model-downloader.js'));

  // Parse arguments: --model=NAME, or the positional form postinstall's
  // recovery hints print ("swictation download-model 1.1b-gpu").
  const modelArg = args.find(arg => arg.startsWith('--model='));
  const positional = args.slice(1).find(arg => !arg.startsWith('-'));
  const modelValue = modelArg ? modelArg.split('=')[1] : (positional || 'both');
  const force = args.includes('--force');

  // Accept every name postinstall recommends plus the downloader's own keys
  // (ADR-034: the old hardcoded ['0.6b','1.1b','both'] rejected the exact
  // names error messages told users to download, incl. the only macOS model).
  const aliasMap = {
    '0.6b-gpu': '0.6b',
    '0.6b-cpu': '0.6b',
    'cpu-only': '0.6b',
    '1.1b-gpu': '1.1b',
    'coreml-native': '1.1b-coreml'
  };
  // CoreML bundles are macOS-only; don't offer them on Linux.
  const downloaderKeys = Object.keys(ModelDownloader.MODELS || {})
    .filter(k => k !== 'vad')
    .filter(k => isMacOS || !k.includes('coreml'));
  const aliasKeys = Object.keys(aliasMap).filter(k => isMacOS || !aliasMap[k].includes('coreml'));
  const validModels = [...new Set([...downloaderKeys, ...aliasKeys, 'both'])];
  if (!validModels.includes(modelValue)) {
    console.error(chalk.red(`Invalid model: ${modelValue}`));
    console.log(chalk.yellow(`Valid options: ${validModels.join(', ')}`));
    process.exit(1);
  }

  // Determine which models to download (VAD is always required)
  let modelKeys;
  if (modelValue === 'both') {
    if (isMacOS) {
      modelKeys = ['vad', '1.1b-coreml'];
      console.log(chalk.cyan('Downloading: Silero VAD + Parakeet-TDT 1.1B (CoreML)'));
    } else {
      modelKeys = ['vad', '0.6b', '1.1b'];
      console.log(chalk.cyan('Downloading: All models (9.43 GB total)'));
    }
  } else {
    const key = aliasMap[modelValue] || modelValue;
    modelKeys = ['vad', key];
    console.log(chalk.cyan(`Downloading: Silero VAD + ${key}`));
  }

  try {
    const downloader = new ModelDownloader({ force });
    await downloader.downloadModels(modelKeys);
  } catch (err) {
    console.error(chalk.red('Download failed:'), err.message);
    process.exit(1);
  }
}

function loadVersionsJson() {
  try {
    const versionsPath = path.join(__dirname, '..', 'versions.json');
    return JSON.parse(fs.readFileSync(versionsPath, 'utf8'));
  } catch (err) {
    return null;
  }
}

function showVersion() {
  console.log(chalk.cyan('Swictation - Voice-to-Text Dictation System'));
  console.log(chalk.gray('─'.repeat(50)));

  // Load versions from versions.json
  const versions = loadVersionsJson();

  if (versions) {
    // Distribution version
    console.log(`${chalk.bold('Distribution Version:')} ${chalk.green(versions.distribution)}`);
    console.log();

    // Component versions
    console.log(chalk.bold('Components:'));
    if (versions.components.daemon) {
      console.log(`  Daemon: ${chalk.green(versions.components.daemon.version)}`);
    }
    if (versions.components.ui) {
      console.log(`  UI: ${chalk.green(versions.components.ui.version)}`);
    }
    if (versions.components['context-learning']) {
      console.log(`  Context Learning: ${chalk.green(versions.components['context-learning'].version)}`);
    }
    console.log();

    // Platform package info
    if (binaryPaths) {
      console.log(chalk.bold('Platform Package:'));
      console.log(`  Package: ${chalk.blue(binaryPaths.packageName)}`);
      console.log(`  Location: ${chalk.gray(binaryPaths.packageDir)}`);
      console.log();

      // ONNX Runtime version
      if (versions.libraries && versions.libraries.onnxruntime) {
        const ortVersion = isMacOS
          ? versions.libraries.onnxruntime['macos-coreml']
          : versions.libraries.onnxruntime['linux-gpu'];
        console.log(chalk.bold('ONNX Runtime:'));
        console.log(`  Version: ${chalk.green(ortVersion)}`);
        console.log(`  Backend: ${chalk.blue(isMacOS ? 'CoreML (Apple Neural Engine)' : 'CUDA (NVIDIA GPU)')}`);
      }
    } else {
      console.log(chalk.yellow('Platform package: Not installed'));
    }
  } else {
    // Fallback to package.json
    const packageJson = require('../package.json');
    console.log(`Version: ${chalk.green(packageJson.version)}`);
  }

  console.log();
  console.log(chalk.gray(`Platform: ${process.platform} ${process.arch}`));
  console.log(chalk.gray(`Node.js: ${process.version}`));

  // Try to get daemon version if available
  if (binaryPaths && daemonBinary && fs.existsSync(daemonBinary)) {
    console.log();
    try {
      const daemonVersion = execSync(`${daemonBinary} --version 2>&1`, {
        encoding: 'utf8',
        timeout: 2000
      }).trim();
      console.log(chalk.gray('Daemon Details:'));
      daemonVersion.split('\n').forEach(line => {
        console.log(chalk.gray(`  ${line}`));
      });
    } catch (err) {
      // Daemon version command failed - that's okay
    }
  }

  process.exit(0);
}

function showHelp() {
  console.log(chalk.cyan('Swictation - Voice-to-Text Dictation System'));
  console.log(chalk.gray('─'.repeat(40)));
  console.log('Usage: swictation [command] [options]');
  console.log();
  console.log('Commands:');
  console.log('  download-models Download AI models from HuggingFace (alias: download-model)');
  console.log('  start [--ui]    Start the daemon (and optionally the UI)');
  console.log('  stop            Stop the daemon');
  console.log('  status          Show service status');
  console.log('  toggle          Toggle recording on/off');
  console.log('  setup           Run the install steps (config, models, services)');
  console.log('  doctor          Check every install step and print repair commands');
  console.log('                  --json   machine-readable report');
  console.log('                  --deep   verify file contents by hash, not just sizes');
  console.log('  help            Show this help message');
  console.log('  --version, -V   Show version information');
  console.log();
  console.log('Setup Options:');
  console.log('  --list          List the install steps and their ids');
  console.log('  --<id>          Run one step (e.g. --models, --services, --gpu-libs)');
  console.log('  --repair        Run only the steps that are not currently healthy');
  console.log();
  console.log('Download Options (also accepted as a positional: download-model 1.1b-gpu):');
  if (isMacOS) {
    console.log('  --model=1.1b-coreml  Download CoreML 1.1B bundle (1.9 GB, Apple Silicon)');
    console.log('  --model=0.6b-coreml  Download CoreML 0.6B bundle (2.67 GB)');
    console.log('  --model=both         VAD + CoreML 1.1B (default on macOS)');
  } else {
    console.log('  --model=0.6b    Download 0.6B model only (2.47 GB, CPU-friendly)');
    console.log('  --model=1.1b    Download 1.1B model only (6.96 GB, GPU-optimized)');
    console.log('  --model=both    Download both models (9.43 GB, default)');
  }
  console.log('  --force         Re-download even if models exist');
  console.log();
  console.log('Examples:');
  console.log('  swictation download-models              # Download all models');
  console.log('  swictation download-models --model=0.6b # CPU-friendly only');
  console.log('  swictation start                        # Start the daemon');
  console.log('  swictation start --ui                   # Start daemon and UI');
  console.log('  swictation toggle                       # Toggle recording');
  console.log('  swictation status                       # Check if running');
  console.log('  swictation doctor                       # Diagnose a broken install');
  console.log('  swictation doctor --deep                # ...and verify every file by hash');
  console.log('  swictation setup --repair               # Fix only what is broken');
  console.log('  swictation setup --services             # Re-generate service units');
  console.log('  swictation --version                    # Show version info');
  process.exit(0);
}

// Helper function to get environment with library paths
function getEnvironmentWithLibraryPath() {
  if (!libDir) {
    return process.env;
  }

  const env = { ...process.env };

  if (isLinux) {
    // Add platform package lib directory to LD_LIBRARY_PATH for GPU libraries
    const currentPath = env.LD_LIBRARY_PATH || '';
    env.LD_LIBRARY_PATH = currentPath ? `${libDir}:${currentPath}` : libDir;
  } else if (isMacOS) {
    // Add platform package lib directory to DYLD_LIBRARY_PATH
    const currentPath = env.DYLD_LIBRARY_PATH || '';
    env.DYLD_LIBRARY_PATH = currentPath ? `${libDir}:${currentPath}` : libDir;
  }

  return env;
}

// Main entry point
async function main() {
  checkPlatform();

  // Handle commands that don't need binaries
  if (command === '--version' || command === '-V' || command === 'version') {
    showVersion();
    return;
  }

  if (command === 'help' || command === '--help' || command === '-h' || command === undefined) {
    showHelp();
    return;
  }

  // download-models doesn't need binaries to exist yet
  // ('download-model' alias: several error messages historically printed the
  // singular form, so both are accepted.)
  if (command === 'download-models' || command === 'download-model') {
    await handleDownloadModels();
    return;
  }

  // doctor and setup must work on a broken install — that is the whole point
  // of having them (ADR-037), so neither waits on checkBinaries()'s exit(1).
  if (command === 'doctor') {
    await handleDoctor();
    return;
  }

  if (command === 'setup') {
    await handleSetup();
    return;
  }

  checkBinaries();

  switch (command) {
    case 'start':
      await handleStart();
      break;
    case 'stop':
      await handleStop();
      break;
    case 'status':
      await handleStatus();
      break;
    case 'toggle':
      await handleToggle();
      break;
    default:
      console.error(chalk.red(`Unknown command: ${command}`));
      console.log(chalk.yellow('Run "swictation help" for usage information'));
      process.exit(1);
  }
}

// Run the CLI
main().catch(err => {
  console.error(chalk.red('Fatal error:'), err);
  process.exit(1);
});
